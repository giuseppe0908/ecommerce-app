# Prisma / Database
# local: use the direct MySQL URL for both variables
# preview/production on Vercel:
# - DATABASE_URL=prisma://...   (Prisma Accelerate pooled URL)
# - DIRECT_DATABASE_URL=mysql://... (direct MySQL URL for migrations and Prisma CLI)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"
DIRECT_DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DB_NAME"

# Runtime
APP_SITE_NAME="Nuxt Commerce"
APP_BASE_URL="http://localhost:3000"
# Legacy fallback. Prefer APP_BASE_URL.
BASE_URL="http://localhost:3000"
LOG_LEVEL="info"

# Auth
JWT_SECRET="replace-with-a-long-random-secret"
GITHUB_CLIENT_ID="replace-with-github-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-client-secret"
GITHUB_CALLBACK_URL="http://localhost:3000/api/auth/github/callback"

# Email
EMAIL_USER="smtp-user@example.com"
EMAIL_PASS="smtp-password-or-app-password"

# Stripe
STRIPE_SECRET_KEY="sk_test_replace_me"
STRIPE_PUBLISHABLE_KEY="pk_test_replace_me"
STRIPE_WEBHOOK_SECRET="whsec_replace_me"

# Optional AI chat
# local with Ollama:
# - AI_CHAT_ENABLED=true
# - AI_CHAT_PROVIDER=ollama
# - AI_CHAT_BASE_URL=http://127.0.0.1:11434
# preview/production without AI backend:
# - AI_CHAT_ENABLED=false
AI_CHAT_ENABLED="false"
AI_CHAT_PROVIDER="ollama"
AI_CHAT_BASE_URL="http://127.0.0.1:11434"
AI_CHAT_MODEL="llama3.2:1b"
AI_CHAT_TIMEOUT_MS="3000"

# Optional cache
REDIS_URL=""
CACHE_REDIS_URL=""
