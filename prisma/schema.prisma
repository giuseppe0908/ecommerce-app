generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}

model Product {
  id               Int      @id @default(autoincrement())
  name             String
  categoryId       Int
  brandId          Int
  favorite        Boolean
  promo            Boolean
  price            Float
  photo            String
  codeItem         String
  percentualPromo  Float
  category         Category @relation(fields: [categoryId], references: [id])
  brand            Brand    @relation(fields: [brandId], references: [id])
}

model Brand {
  id    Int    @id @default(autoincrement())
  name  String
  products Product[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String
  products Product[]
}

model User {
  id       Int    @id @default(autoincrement())
  name     String
  surname  String
  email    String  @unique
  password String
  orders   Order[]
}

model Order {
  id        Int    @id @default(autoincrement())
  idUtente  Int
  codeId    String
  price     Float
  user      User   @relation(fields: [idUtente], references: [id])
}
