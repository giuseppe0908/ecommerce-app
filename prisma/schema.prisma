generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}



model Product {
  id               Int       @id @default(autoincrement())
  name             String
  categoryId       Int
  brandId          Int
  genderId         Int
  favorite         Boolean?
  promo            Boolean
  plus             Boolean  
  newArrival       Boolean   
  price            Float
  photo            String
  codeItem         String
  percentualPromo  Float
  rating           Float?  
  description      String  
  available_quantity Int 
  subCategoryId Int?
  features         ProductFeature[] 
  subCategory      SubCategory? @relation(fields: [subCategoryId], references: [id])
  category         Category       @relation(fields: [categoryId], references: [id])
  productColors    ProductColor[] // Relazione esplicita con la tabella di join  category         Category  @relation(fields: [categoryId], references: [id])
  brand            Brand     @relation(fields: [brandId], references: [id])
  gender           Gender   @relation(fields: [genderId], references: [id]) // Relazione con Gender
  reviews          Review[]  // Relazione per le recensioni degli utenti
  orders           OrderProduct[] // Relazione Many-to-Many tramite tabella intermedia
  favoritedBy      Favorite[] // Relazione con gli utenti che hanno messo il prodotto nei preferiti
}
model Color {
  id              Int            @id @default(autoincrement())
  name            String
  hex             String?
  productColors   ProductColor[]  // Relazione opposta
}

model ProductColor {
  productId Int
  colorId   Int
  product   Product @relation(fields: [productId], references: [id])
  color     Color   @relation(fields: [colorId], references: [id])

  @@id([productId, colorId]) // Chiave primaria composta se è una tabella di join
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model SubCategory {
  id          Int      @id @default(autoincrement())
  name        String
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  products    Product[] // Se i prodotti appartengono direttamente a una sottocategoria
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String
  images        CategoryImage[]  // Relazione con le immagini per genere
  products      Product[]        // Relazione con i prodotti appartenenti alla categoria
  subCategories SubCategory[]   // Nuova relazione verso le sottocategorie
  features      Feature[]
}

model CategoryImage {
  id           Int        @id @default(autoincrement())
  imageUrl     String     // URL dell'immagine
  genderId     Int      
  categoryId   Int
  category     Category    @relation(fields: [categoryId], references: [id])
  gender       Gender      @relation(fields: [genderId], references: [id])
}

model Feature {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  type        String    // 'text', 'select', 'range' (per UI)
  category    Category? @relation(fields: [categoryId], references: [id])
  categoryId  Int?
  products    ProductFeature[]
  options     String[]  // Per type 'select' es: ["S", "M", "L"]
}

model ProductFeature {
  productId  Int
  featureId  Int
  value      String
  product    Product @relation(fields: [productId], references: [id])
  feature    Feature @relation(fields: [featureId], references: [id])
  @@id([productId, featureId])
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  surname  String
  email    String    @unique
  password String
  address  String
  number   String
  newsletter Boolean ?
  orders   Order[]
  reviews  Review[] 
  favorites Favorite[] // Relazione con i preferiti
  role     Role      @default(USER)
  createdAt DateTime @default(now())
  tokens    Token[]   // Relazione con i token
  resetTokens     ResetToken[] 

}

model Token {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String     @db.Text // Utilizzo del tipo Text per lunghezza illimitatas
  expiresAt DateTime
  createdAt DateTime  @default(now())
  @@index([userId])
  @@index([token]) // Creiamo un indice sulla prima parte del token
}

model ResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime // Scadenza del token
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

model Order {
  id        Int            @id @default(autoincrement())
  idUtente  Int
  price     Float
  user      User           @relation(fields: [idUtente], references: [id])
  products  OrderProduct[] // Relazione Many-to-Many tramite tabella intermedia
}

model OrderProduct {
  id        Int       @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int       @default(1) // Quantità del prodotto nell'ordine
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([orderId, productId]) // Evita duplicati dello stesso prodotto nello stesso ordine
}
model Gender {
  id        Int       @id @default(autoincrement())
  name      String
  products  Product[] // Relazione con i prodotti
  categoryImages CategoryImage[]
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Int
  comment   String
  // Add this field
  createdAt DateTime @default(now())
  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@unique([userId, productId]) // Evita duplicati dello stesso prodotto per lo stesso utente
  @@index([userId])
  @@index([productId])
}
