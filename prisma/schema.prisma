generator client {
  provider = "prisma-client-js"
}

// prisma/schema.prisma
datasource db {
  provider  = "postgresql"
  url  	    = env("DATABASE_URL")
}


model Product {
  id               Int       @id @default(autoincrement())
  name             String
  categoryId       Int
  brandId          Int
  genderId         Int
  favorite         Boolean
  promo            Boolean
  plus             Boolean  
  newArrival       Boolean   
  price            Float
  photo            String
  codeItem         String
  percentualPromo  Float
  rating           Float?  
  description      String  
  category         Category  @relation(fields: [categoryId], references: [id])
  brand            Brand     @relation(fields: [brandId], references: [id])
  gender           Gender   @relation(fields: [genderId], references: [id]) // Relazione con Gender
  reviews          Review[]  // Relazione per le recensioni degli utenti
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String
  products Product[]
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String
  images        CategoryImage[]  // Relazione con le immagini per genere
  products      Product[]        // Relazione con i prodotti appartenenti alla categoria
}

model CategoryImage {
  id           Int        @id @default(autoincrement())
  imageUrl     String     // URL dell'immagine
  genderId     Int      
  categoryId   Int
  category     Category    @relation(fields: [categoryId], references: [id])
  gender       Gender      @relation(fields: [genderId], references: [id])
}

model User {
  id       Int       @id @default(autoincrement())
  name     String
  surname  String
  email    String    @unique
  password String
  orders   Order[]
  reviews  Review[] 
  role     Role      @default(USER)
  createdAt DateTime @default(now())
  tokens    Token[]   // Relazione con i token
}

model Token {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum Role {
  USER
  ADMIN
}

model Order {
  id        Int       @id @default(autoincrement())
  idUtente  Int
  codeId    String
  price     Float
  user      User      @relation(fields: [idUtente], references: [id])
}

model Gender {
  id        Int       @id @default(autoincrement())
  name      String
  products  Product[] // Relazione con i prodotti
  categoryImages CategoryImage[]
}

model Review {
  id        Int       @id @default(autoincrement())
  productId Int
  userId    Int
  rating    Float     // Valutazione da parte dell'utente
  comment   String?   // Commento facoltativo dell'utente
  product   Product   @relation(fields: [productId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}
